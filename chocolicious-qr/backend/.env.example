# Razorpay Test Mode credentials.
#
# 1. Log in to https://dashboard.razorpay.com
# 2. Toggle "Test Mode" ON (top right)
# 3. Go to Settings -> API Keys -> Generate Test Key
# 4. Copy this file to backend/.env and paste your values below.
#
# NEVER commit backend/.env. NEVER put live (non-test) keys here for
# this project stage - Test Mode only, per the current implementation.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_test_key_secret_here

# Optional, local development only. When "true", re-enables the old
# POST /api/orders endpoint (creates an order with no payment at all).
# Leave unset/false in every normal case - it exists purely as an
# escape hatch for local testing without going through Razorpay.
# ALLOW_DIRECT_ORDER_CREATION=false

# Extra charge for Parcel orders, in rupees. Optional - defaults to 10.
# PARCEL_CHARGE=10

# Owner login - pick your own values, there is no default.
OWNER_USERNAME=owner
OWNER_PASSWORD=change_me_to_something_only_you_know

# Signs the login token. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Changing this logs every owner out immediately.
FLASK_SECRET_KEY=change_me_to_a_long_random_string
